{
  "name": "sonnenwetter",
  "productName": "Sonnenwetter",
  "version": "2.0.0",
  "description": "Die einzige Wetter-App mit 100 % Sonnengarantie",
  "author": "Joschka Peeters",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "de.joschka.sonnenwetter",
    "productName": "Sonnenwetter",
    "files": ["main.js", "index.html", "manifest.json", "sw.js", "icon-*.png", "vendor/**/*"],
    "directories": { "output": "dist" },
    "win": { "target": ["nsis", "portable"], "icon": "./icon-512.png" },
    "mac": { "target": ["dmg"], "icon": "./icon-512.png" },
    "linux": { "target": ["AppImage"], "icon": "./icon-512.png" }
  }
}
